name: cysee-lab

services:
  # ==========================================
  # UNIDADE A (Emissor SNMP + Agente Rust A)
  # ==========================================
  snmp-emitter-a:
    build: ./snmp-emitter
    container_name: snmp-emitter-a
    hostname: snmp-emitter-a
    networks:
      net_unit_a:
        ipv4_address: 172.20.10.10
    restart: unless-stopped

  cysee-agent-a:
    build: ./cysee-agent
    container_name: cysee-agent-a
    hostname: cysee-agent-a
    environment:
      - NODE_ID=unit-a
      - CENTRAL_ADDR=172.20.101.100:50051
    cap_add:
      - NET_ADMIN
      - NET_BIND_SERVICE
    sysctls:
      - net.core.rmem_max=262144
    volumes:
      - vol_agent_a:/var/lib/cysee
    networks:
      net_unit_a:
        ipv4_address: 172.20.10.2
      net_ingest_a:
        ipv4_address: 172.20.101.2
    depends_on:
      - cysee-central
    restart: unless-stopped

  # ==========================================
  # UNIDADE B (Emissor SNMP + Agente Rust B)
  # ==========================================
  snmp-emitter-b:
    build: ./snmp-emitter
    container_name: snmp-emitter-b
    hostname: snmp-emitter-b
    networks:
      net_unit_b:
        ipv4_address: 172.20.20.10
    restart: unless-stopped

  cysee-agent-b:
    build: ./cysee-agent
    container_name: cysee-agent-b
    hostname: cysee-agent-b
    environment:
      - NODE_ID=unit-b
      - CENTRAL_ADDR=172.20.102.100:50051
    cap_add:
      - NET_ADMIN
      - NET_BIND_SERVICE
    sysctls:
      - net.core.rmem_max=262144
    volumes:
      - vol_agent_b:/var/lib/cysee
    networks:
      net_unit_b:
        ipv4_address: 172.20.20.2
      net_ingest_b:
        ipv4_address: 172.20.102.2
    depends_on:
      - cysee-central
    restart: unless-stopped

  # ==========================================
  # NÚCLEO CENTRAL (Binário Rust Único)
  # ==========================================
  cysee-central:
    build: ./cysee-central
    container_name: cysee-central
    hostname: cysee-central
    sysctls:
      - net.ipv4.ip_forward=0
    volumes:
      - vol_central:/var/lib/cysee
    ports:
      - "8080:8080"
    networks:
      net_ingest_a:
        ipv4_address: 172.20.101.100
      net_ingest_b:
        ipv4_address: 172.20.102.100
      net_mgmt:
        ipv4_address: 172.20.99.100
    restart: unless-stopped

  # ==========================================
  # GERÊNCIA: Grafana (Seguindo Doc Oficial)
  # ==========================================
  grafana:
    image: grafana/grafana-oss:latest
    container_name: grafana
    hostname: grafana
    ports:
      - "3000:3000"
    environment:
      - GF_INSTALL_PLUGINS=yesoreyeram-infinity-datasource
    volumes:
      - grafana-storage:/var/lib/grafana
    networks:
      net_mgmt:
        ipv4_address: 172.20.99.10
    depends_on:
      - cysee-central
    restart: unless-stopped

networks:
  net_unit_a:
    driver: bridge
    internal: true
    ipam:
      config:
        - subnet: 172.20.10.0/24
  net_unit_b:
    driver: bridge
    internal: true
    ipam:
      config:
        - subnet: 172.20.20.0/24
  net_ingest_a:
    driver: bridge
    internal: true
    ipam:
      config:
        - subnet: 172.20.101.0/24
  net_ingest_b:
    driver: bridge
    internal: true
    ipam:
      config:
        - subnet: 172.20.102.0/24
  net_mgmt:
    driver: bridge
    ipam:
      config:
        - subnet: 172.20.99.0/24

volumes:
  vol_agent_a:
  vol_agent_b:
  vol_central:
  grafana-storage: